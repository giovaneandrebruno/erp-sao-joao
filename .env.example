# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Opcional: permite criar usuários direto pela tela "Equipe e parceiros".
# Use a chave secreta (sb_secret_...). NUNCA coloque NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=
